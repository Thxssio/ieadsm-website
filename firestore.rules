rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.role in [
          'admin','pastor','supervisor_departamento','supervisor_setor'
        ];
    }

    function canWriteMinistry() {
      return isAdmin() ||
        (request.auth != null && request.auth.token.role == 'ministro');
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isFamilyMember(familyId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    // users
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // schedule (público lê; só admin escreve)
    match /schedule/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // site content (público lê; apenas admin escreve)
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // links (público lê; apenas admin escreve)
    match /links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

      // ministries (público lê; só perfis autorizados escrevem)
      match /ministries/{ministryId} {
        allow read: if true;
        allow write: if canWriteMinistry();
      }

      // sectors (público lê; apenas admin escreve)
      match /sectors/{sectorId} {
        allow read: if true;
        allow write: if isAdmin();

        match /congregations/{congregationId} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }

      // counters (geração sequencial de IDs etc.)
      match /counters/{counterId} {
        allow read, write: if request.auth != null;
      }

    match /cpf_index/{cpf} {
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/cpf_index/$(cpf));

      allow update: if request.auth != null
        && (!('uid' in resource.data) || resource.data.uid == request.auth.uid)
        && request.resource.data.uid == request.auth.uid;

      allow read: if isAdmin();

      allow delete: if isAdmin();
    }


    match /idInterno_index/{idInterno} {
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/idInterno_index/$(idInterno));

      allow update: if request.auth != null
        && (!('uid' in resource.data) || resource.data.uid == request.auth.uid)
        && request.resource.data.uid == request.auth.uid;

      allow read: if isAdmin();

      allow delete: if isAdmin();
    }

    match /familyId_index/{familyId} {
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/familyId_index/$(familyId));

      allow read: if isAdmin();

      allow delete: if isAdmin();
    }

    match /families/{familyId} {
      // Qualquer usuário autenticado pode criar sua própria família. Leitura
      // e demais operações ficam restritas aos administradores ou membros
      // daquela família.
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin() || isFamilyMember(familyId);

      match /members/{memberId} {
        // Permite que o usuário crie seu próprio registro de membro antes de
        // existir vínculo com a família. Após vinculado, qualquer membro ou
        // administrador pode gerenciar os demais integrantes.
        allow create: if isAdmin() || isFamilyMember(familyId) || (request.auth != null && request.auth.uid == memberId);
        allow read, update, delete: if isAdmin() || isFamilyMember(familyId);
      }


      // Demais subcoleções ou documentos dentro de uma família são bloqueados
      // explicitamente.
      match /{document=**} {
        allow read, write: if false;
      }

    }
  }
}