rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.role in [
          'admin',
          'pastor',
          'supervisor_departamento',
          'supervisor_setor'
        ];
    }

    function canWriteMinistry() {
      return isAdmin() ||
        (request.auth != null && request.auth.token.role == 'ministro');
    }

    // imagens dos ministérios
    match /ministries/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMinistry();
    }

    // imagens de perfil dos usuários
    match /profileImages/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // demais caminhos: só leitura pública, escrita bloqueada
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
